# moose appliance — load the LAN+mesh scoping rule for SSH (:22). #467;
# BUILD.md # SSH.
#
# The rule lives in its own nftables table, so loading it never touches Docker's
# ruleset and Docker never flushes it. It is a STANDING policy applied on every
# boot, not something turned on with the daemon: the account toggle decides
# whether sshd answers, and this decides who can reach it when it does. Loading
# it unconditionally means there is no window in which the port is reachable from
# anywhere.
#
# Ordered before sshd so the scope is in place before the daemon can ever answer,
# and After=nftables.service so Debian's own ruleset load does not run afterwards
# and race it. Both are Wants-free ordering: neither unit is pulled in by this one.
[Unit]
Description=moose — scope SSH (:22) to the LAN and the mesh
Documentation=https://github.com/onmoose/moose/blob/main/docs/specs/BUILD.md
Before=ssh.service host-agent.service
After=nftables.service
ConditionPathExists=/etc/nftables.d/moose-ssh.conf

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables.d/moose-ssh.conf

[Install]
WantedBy=multi-user.target
