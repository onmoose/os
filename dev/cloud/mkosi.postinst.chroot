#!/bin/bash
# Hosted cloud image first-boot wiring (#242), run inside the image (.chroot mode,
# mkosi v27+). Auto-detected for dev/cloud/ — and, because the test lane does
# `Include=..`, mkosi chdir's into dev/cloud/ and runs this for the boot-proof
# image too (so the test image carries the same production wiring it must validate).
#
# Wires the hosted control plane to come up on first boot:
#   - enable docker + containerd, systemd-networkd, host-agent, the first-boot
#     image loader, and the provisioning-seed materializer (.wants symlinks —
#     `systemctl enable` can't run in the chroot);
#   - the moose / moose-app / moose-shared / moose-remap identities host-agent +
#     the brain resolve by name come from /usr/lib/sysusers.d/moose.conf, not
#     from useradd here (BUILD.md # 1b rule 3);
#   - bring the single virtio NIC up via systemd-networkd DHCP — the minimal
#     cloud-native path, NO NetworkManager (ENVIRONMENT.md # Networking, # Boot);
#   - pre-commit machine-id + mask systemd-firstboot so the interactive wizard
#     never blocks boot;
#   - the A/B layout (#561): the kernel and initramfs inside the slot, GRUB's
#     modules and the first grubenv on the ESP, the read-only slot's mount
#     points, and the jobs that would write to the slot masked (the end of
#     this file).
#
# Deliberately NOT here (hosted cuts, ENVIRONMENT.md # How the profile is realized):
# NetworkManager, Avahi, the LUKS/TPM enrollment of the medium lane. sshd used to
# be on that list; #467 moved it — the daemon ships, but it is left STOPPED here
# rather than enabled (see the ssh.service block below).
#
# The serial-driven boot self-check is test-lane-only — it is enabled by
# dev/cloud/test/mkosi.postinst.chroot, not here.
set -euo pipefail

# Enable a unit by dropping its multi-user.target.wants symlink (no systemctl in
# the chroot). $1 = unit file path (/lib or /etc), $2 = unit name.
enable_unit() {
    mkdir -p /etc/systemd/system/multi-user.target.wants
    ln -sf "$1" "/etc/systemd/system/multi-user.target.wants/$2"
}

# Docker (baked from Docker's apt repo) + its dependency. The brain's compose +
# host-agent's proxy run on it; no physical-disk assembly to order after in hosted.
enable_unit /lib/systemd/system/docker.service     docker.service
enable_unit /lib/systemd/system/containerd.service containerd.service

# systemd-networkd brings the single NIC up (no NM in hosted). Enable it and its
# socket; the .network match below is what actually configures the NIC.
systemctl --root=/ enable systemd-networkd.service >/dev/null 2>&1 || true
# Nothing orders against network-online.target, so don't let wait-online stall boot.
systemctl --root=/ disable systemd-networkd-wait-online.service >/dev/null 2>&1 || true

# Keep systemd-networkd's hands off Docker's own interfaces. The DHCP match below
# is `Type=ether`, which also matches Docker's per-container veth endpoints and the
# docker0 / br-<id> bridges. Left managed, networkd resets them — the bridge ends
# up NO-CARRIER and the veths un-enslaved, so inter-container ARP never resolves
# (the brain can't reach the socket-proxy: "no route to host"). NetworkManager (the
# appliance/medium lane) ignores these by default; networkd does not, so mark them
# unmanaged explicitly. Lower filename prefix → evaluated before 20-dhcp.network,
# so it claims the virtual links first and the real NIC still falls through to DHCP.
mkdir -p /etc/systemd/network
cat > /etc/systemd/network/05-docker-unmanaged.network <<'EOF'
[Match]
Name=docker* veth* br-*

[Link]
Unmanaged=yes
EOF

# Single virtio NIC via DHCP — addressing comes from the cloud's DHCP/metadata
# (ENVIRONMENT.md # Networking, "One virtual NIC"). Match by link type, not a
# slot-dependent predictable name: a cloud VM has exactly one ethernet NIC.
cat > /etc/systemd/network/20-dhcp.network <<'EOF'
[Match]
Type=ether

[Network]
DHCP=yes
EOF

# Static DNS resolver. The lean image ships NO systemd-resolved (not in the
# package set) and systemd-networkd does not itself write /etc/resolv.conf, so
# without this the box gets an IP via DHCP but has NO name resolution — only
# /etc/hosts. That is invisible until something must resolve a public name: the
# box reaches the metadata service and its own :80 by IP, so it boots and serves,
# but the brain's Caddy cannot resolve acme-v02.api.letsencrypt.org or
# auth.onmoose.io, so the wildcard-cert ACME flow never starts (#207 / C3b)
# and :443 stays certless. Docker also derives a bridge container's resolver from
# the host's /etc/resolv.conf; with the file absent, moose-caddy (a moose-ingress
# container) inherits no usable resolver — the same Docker-DNS gap the cloud
# control-plane deploy had to patch. A static file with public resolvers is the
# no-extra-package fix (resolved would change the lean manifest); the box only
# ever resolves public names (control-plane images are baked, no registry pulls).
cat > /etc/resolv.conf <<'EOF'
# moose hosted cloud image — static resolver (no systemd-resolved in the lean set).
nameserver 1.1.1.1
nameserver 8.8.8.8
nameserver 9.9.9.9
EOF
chmod 0644 /etc/resolv.conf

# host-agent (slim, -tags hosted) launches the brain; its drop-in (staged in
# mkosi.extra.wiring) points the bootstrap at the baked images + control-plane
# dir. Order-after the image loader lives in that drop-in.
enable_unit /etc/systemd/system/host-agent.service host-agent.service

# First-boot control-plane image loader (reused verbatim from the medium lane).
enable_unit /etc/systemd/system/moose-load-images.service moose-load-images.service

# First-boot provisioning-seed materializer (C3a cloud-lane, #220). Lands the
# delivered seed at /var/lib/moose/seed.json before host-agent launches the brain;
# no-ops on an un-seeded boot.
enable_unit /etc/systemd/system/moose-seed.service moose-seed.service

# sshd installed, NOT started at boot (#467; BUILD.md # SSH). Debian's
# openssh-server postinst enables ssh.service, which would leave every hosted box
# answering on :22 for its whole life. On this profile that is the entire port
# control: there is no moose firewall and the provider attaches none, so a running
# daemon IS an open port (ENVIRONMENT.md # Access & files). The brain starts the
# unit through host-agent when the first account turns SSH on and stops it when the
# last one turns it off, so a box nobody uses SSH on presents no port at all.
#
# Remove the postinst's multi-user.target.wants link and add a preset saying the
# same thing, so a `systemctl preset-all` on first boot does not re-enable it.
# ssh.socket is left alone: Debian trixie does not enable it on install (only
# ssh.service gets a link), so the service unit is the whole of the port control.
rm -f /etc/systemd/system/multi-user.target.wants/ssh.service
systemctl --root=/ disable ssh.service >/dev/null 2>&1 || true

# Delete the host keys Debian's postinst generated at BUILD time. Baked keys mean
# every box provisioned from this image shares them, so anyone with the published
# image could impersonate any hosted box to its owner's ssh client. Same reasoning
# as the empty /etc/machine-id below: per-box identity is generated on the box.
#
# Debian's sshd-keygen.service cannot regenerate them here — it is
# ConditionFirstBoot=yes and only pulled in by ssh.service, and on this profile
# sshd usually first starts long after the first boot, when that condition is
# false. moose-sshd-keygen.service is the same job without the condition, pulled
# in at BOOT rather than with the daemon: host-agent runs `sshd -t` to validate the
# rendered config before it ever starts the unit, and that exits "no hostkeys
# available" when there are none, so keys arriving with the daemon arrive too late
# for the first enable to succeed. Keys on disk open nothing; the port is still the
# daemon's run state.
rm -f /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub
enable_unit /etc/systemd/system/moose-sshd-keygen.service moose-sshd-keygen.service
mkdir -p /etc/systemd/system/ssh.service.wants
ln -sf /etc/systemd/system/moose-sshd-keygen.service \
    /etc/systemd/system/ssh.service.wants/moose-sshd-keygen.service
mkdir -p /usr/lib/systemd/system-preset
cat > /usr/lib/systemd/system-preset/99-moose-ssh.preset <<'EOF'
# moose owns sshd's run state (BUILD.md # SSH). Installed, off until an account
# opts in; host-agent starts and stops the unit.
disable ssh.service
disable ssh.socket
EOF

# Block app-container egress to the cloud metadata endpoint (169.254.169.254) so an
# untrusted app container cannot read the first-boot seed secrets via the classic
# cloud-metadata SSRF (#251, ENVIRONMENT.md # Provisioning & first-boot). A standing
# forward-hook nft DROP applied every boot before docker/host-agent start any
# container; the host-root seed fetch (OUTPUT path) is untouched. The unit + ruleset
# are committed static files under mkosi.extra/ (etc/moose/metadata-firewall.nft).
enable_unit /etc/systemd/system/moose-metadata-firewall.service moose-metadata-firewall.service

# The OS update trial's safety net (UPDATES.md # 1, #563): reboots a box whose
# new slot was never marked good, when host-agent itself cannot. A timer, so
# it goes under timers.target.
mkdir -p /etc/systemd/system/timers.target.wants
ln -sf /etc/systemd/system/moose-os-trial.timer /etc/systemd/system/timers.target.wants/moose-os-trial.timer
chmod 0755 /usr/lib/moose/os-trial-check


# Docker's daemon-wide userns-remap (#530, BUILD.md # User-namespace remap).
# daemon.json names moose-remap (made by /usr/lib/sysusers.d/moose.conf, with
# the other moose identities; BUILD.md # 1b rule 3), and dockerd reads that account's range from
# /etc/subuid and /etc/subgid. The range is host ids 1000000 to 1065535, far above
# every moose band (2000/2001, app services from 2100, users from 3000). It is
# written here, before any user exists. SUB_UID_COUNT 0 and SUB_GID_COUNT 0 in
# login.defs stop useradd from giving each new user a range of its own, so no
# account can use newuidmap to reach the remap range. The appliance image does
# the same in dev/test-qemu/mkosi.postinst.chroot. Idempotent.
for f in /etc/subuid /etc/subgid; do
    touch "$f"
    grep -q '^moose-remap:' "$f" || echo 'moose-remap:1000000:65536' >> "$f"
done
for k in SUB_UID_COUNT SUB_GID_COUNT; do
    if grep -qE "^[#[:space:]]*${k}[[:space:]]" /etc/login.defs; then
        sed -i -E "s/^[#[:space:]]*${k}[[:space:]].*/${k} 0/" /etc/login.defs
    else
        echo "${k} 0" >> /etc/login.defs
    fi
done

# Make the staged binaries/scripts executable (ExtraTrees preserves mode, but be
# defensive — a clobbered mode would otherwise fail silently at boot).
chmod 0755 /usr/lib/moose/host-agent-real 2>/dev/null || true
chmod 0755 /usr/lib/moose/load-control-plane-images.sh 2>/dev/null || true
chmod 0755 /usr/local/bin/moose-seed-materialize.sh 2>/dev/null || true

# Leave machine-id empty (zero bytes, file present) so systemd generates a unique
# one on each VM's first real boot. Pre-committing it here would bake the build
# host's entropy into every snapshot — all provisioned VMs would share the same
# machine-id, causing DHCPv6 DUID collisions and indistinguishable journal entries
# when logs are forwarded to a central collector. An empty-but-present file is the
# standard golden-image approach; systemd's machine-id-commit service initializes it
# at runtime without blocking boot.
: > /etc/machine-id
# Mask systemd-firstboot.service so the interactive locale/timezone wizard never
# blocks sysinit (the empty machine-id is not enough to suppress it alone).
systemctl --root=/ mask systemd-firstboot.service >/dev/null 2>&1 || true

# ---------------------------------------------------------------------------
# The A/B layout (#561, BUILD.md # 1b). The image carries the ESP, the BIOS boot
# partition and slot A; slot B and the state partition come at first boot.

# The kernel and a Debian initramfs inside the slot, where grub.cfg reads them
# (/usr/lib/moose/boot/). A slot is one self-contained unit: the kernel always
# matches the root it boots. The initramfs is Debian's initramfs-tools (already
# in the image: linux-image-amd64 depends on it), because its local-bottom hook
# (/etc/initramfs-tools/scripts/local-bottom/moose-state) runs the early state
# setup before systemd starts.
#
# The kernel is MOVED, not copied. mkosi copies every kernel it finds in
# /usr/lib/modules/<kver>/ (or /boot) to the ESP, with an initrd of its own and
# menu entries after grub.cfg's. Nothing boots those, and they would need a
# much larger ESP. With the kernel moved, mkosi finds none (mkosi.conf,
# Bootable=auto), and the ESP holds only GRUB (mkosi.repart/00-esp.conf).
chmod 0755 /etc/initramfs-tools/scripts/local-bottom/moose-state /usr/lib/moose/state-setup
kver="$(ls /usr/lib/modules | sort -V | tail -n1)"
mkdir -p /usr/lib/moose/boot
if [ -e "/usr/lib/modules/$kver/vmlinuz" ]; then
    mv "/usr/lib/modules/$kver/vmlinuz" /usr/lib/moose/boot/vmlinuz
else
    mv "/boot/vmlinuz-$kver" /usr/lib/moose/boot/vmlinuz
fi
rm -f /boot/vmlinuz-* /usr/lib/modules/*/vmlinuz
# The initramfs mounts the slot (squashfs), and state-setup mounts the state
# partition (ext4) and the /etc overlay. Those mounts happen inside the
# initramfs, so their modules must be in it, whatever MODULES= picks.
for m in squashfs overlay ext4; do
    grep -qx "$m" /etc/initramfs-tools/modules || echo "$m" >> /etc/initramfs-tools/modules
done
mkinitramfs -o /usr/lib/moose/boot/initrd.img "$kver"
# The kernel's own postinst made a second initramfs in /boot. Nothing reads it.
rm -f /boot/initrd.img-*
ls -l /usr/lib/moose/boot/

# GRUB modules on the ESP, so grub.cfg can insmod squash4, xzio, regexp,
# loadenv and test. mkosi's core images embed only a short list. About 3 MB
# per firmware.
mkdir -p /efi/grub
for p in i386-pc x86_64-efi; do
    rm -rf "/efi/grub/$p"
    cp -r "/usr/lib/grub/$p" "/efi/grub/$p"
done

# The first grubenv (RAUC's GRUB backend): slot A holds this image and is good,
# slot B is empty.
grub-editenv /efi/grub/grubenv create
grub-editenv /efi/grub/grubenv set ORDER="A B" A_OK=1 A_TRY=0 B_OK=0 B_TRY=0

# The slot is mounted read-only, so every mount point must already exist: the
# state partition's, the bind targets (state-setup refuses a missing one), the
# ESP's and /var/tmp's. /opt/containerd/{bin,lib} are made by containerd when
# it starts if they are missing, so they are made here instead.
mkdir -p /state /efi /home /srv/moose /var/log /var/tmp \
    /var/lib/docker /var/lib/containerd /var/lib/moose /var/lib/systemd \
    /var/lib/rauc /var/lib/sudo /opt/containerd/bin /opt/containerd/lib
# dbus's tmpfiles rule makes this link at boot when it is missing.
mkdir -p /var/lib/dbus
ln -sf /etc/machine-id /var/lib/dbus/machine-id

# The slot replaces these jobs, or they would write to it:
#   - systemd-repart.service: state-setup runs repart in the initramfs, before
#     systemd, on every boot. One owner.
#   - ldconfig.service: the slot ships its own ld.so.cache. A copy written into
#     the /etc upper layer would outlive the slot it describes, and after a
#     revert it would name libraries of the newer slot.
#   - systemd-update-done.service: it stamps /var/.updated on the read-only
#     slot. Without it, the ConditionNeedsUpdate jobs (systemd-sysusers, the
#     journal catalog) run on every boot, which is what an image that can swap
#     under /etc needs anyway.
systemctl --root=/ mask systemd-repart.service ldconfig.service systemd-update-done.service >/dev/null
